{
  "name": "@composa/ui",
  "version": "0.0.8",
  "author": "Sébastien Bosmans <https://github.com/boseba>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/boseba/composa-ui.git"
  },
  "scripts": {
    "ng": "ng",
    "build": "ng build ui",
    "build:watch": "ng build ui --watch --configuration development",
    "test": "ng test ui",
    "test:ci": "ng test ui --watch=false",
    "test:coverage": "ng test ui --watch=false --coverage",
    "lint": "ng lint ui",
    "lint:fix": "ng lint ui --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.1.0",
    "@angular-eslint/eslint-plugin": "^21.1.0",
    "@angular-eslint/eslint-plugin-template": "^21.1.0",
    "@angular-eslint/template-parser": "^21.1.0",
    "@angular/build": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.0",
    "@eslint/js": "^9.39.2",
    "@vitest/coverage-v8": "^4.1.5",
    "angular-eslint": "21.1.0",
    "eslint": "^9.39.1",
    "jsdom": "^27.1.0",
    "ng-packagr": "^21.0.0",
    "sass": "^1.97.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.51.0",
    "vitest": "^4.1.5"
  }
}
